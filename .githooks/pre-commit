#!/bin/sh
# Optional pre-commit hook: formatting and lint gate.
# Enable with:   git config core.hooksPath .githooks
# Skip once with: git commit --no-verify
set -eu

if ! command -v cargo >/dev/null 2>&1; then
    if [ -x "$HOME/.cargo/bin/cargo" ]; then
        PATH="$HOME/.cargo/bin:$PATH"
        export PATH
    else
        echo "pre-commit: cargo not found; skipping checks" >&2
        exit 0
    fi
fi

echo "pre-commit: cargo fmt --check" >&2
if ! cargo fmt --all -- --check; then
    echo "pre-commit: run 'cargo fmt' and re-stage" >&2
    exit 1
fi

echo "pre-commit: cargo clippy --all-targets -- -D warnings" >&2
cargo clippy --all-targets --quiet -- -D warnings
